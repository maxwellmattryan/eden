{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window on every platform: the always-on plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-appdata-write-recursive",
    "fs:allow-mkdir",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "notification:default"
  ]
}
