{
	"name": "@eden/shared",
	"version": "0.1.0",
	"private": true,
	"description": "Frontend code the desktop and mobile apps share: the Tauri API wrappers, the settings state, the crash store, i18n and the types behind them. Consumed from source like the kit.",
	"type": "module",
	"exports": {
		"./api": "./src/api/index.ts",
		"./api/updater": "./src/api/updater.ts",
		"./stores": "./src/stores/index.ts",
		"./splash": "./src/splash/index.ts",
		"./settings": "./src/settings/index.ts",
		"./persistence": "./src/persistence/index.ts",
		"./data": "./src/data/index.ts",
		"./grants": "./src/grants/index.ts",
		"./egress": "./src/egress/index.ts",
		"./profile": "./src/profile/index.ts",
		"./registry": "./src/registry/index.ts",
		"./manifest": "./src/manifest/index.ts",
		"./domains/kitchen": "./src/domains/kitchen/index.ts",
		"./domains/toolbench": "./src/domains/toolbench/index.ts",
		"./dates": "./src/dates/index.ts",
		"./shortcuts": "./src/shortcuts/index.ts",
		"./navigation": "./src/navigation/index.ts",
		"./weather": "./src/weather/index.ts",
		"./i18n": "./src/i18n/index.ts",
		"./types": "./src/types/index.ts"
	},
	"scripts": {
		"registry": "node scripts/build-registry.mjs",
		"registry:check": "node scripts/build-registry.mjs --check",
		"check": "yarn registry:check && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@tauri-apps/api": "2.12.0",
		"svelte-i18n": "4.0.1"
	},
	"peerDependencies": {
		"@eden/ui-kit": "0.1.0",
		"@tauri-apps/plugin-process": "2.4.0",
		"@tauri-apps/plugin-updater": "2.13.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@tauri-apps/plugin-process": {
			"optional": true
		},
		"@tauri-apps/plugin-updater": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tauri-apps/plugin-process": "2.4.0",
		"@tauri-apps/plugin-updater": "2.13.0",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
